# ── Correo (Resend) ──────────────────────────────────────────────
# Crea una cuenta en https://resend.com y genera tu API key.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Correo donde recibirás los leads (tu inbox)
CONTACT_TO_EMAIL=tu@correo.com

# Remitente — en pruebas usa onboarding@resend.dev
# En producción verifica tu dominio en Resend (ej. contacto@mendifly.com)
CONTACT_FROM_EMAIL=Mendifly <onboarding@resend.dev>

# ── Base de datos (Supabase) ───────────────────────────────────
# Crea un proyecto en https://supabase.com
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── SQL para crear la tabla leads en Supabase ───────────────────
# Ejecuta esto en el SQL Editor de Supabase:
#
# create table if not exists public.leads (
#   id uuid primary key default gen_random_uuid(),
#   name text not null,
#   email text not null,
#   phone text,
#   service text not null,
#   message text not null,
#   source_page text,
#   created_at timestamptz not null default now()
# );
#
# alter table public.leads enable row level security;
# (No policies needed — only server uses service_role key)
